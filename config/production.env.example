# 生产专用模板，保存到 .deploy/production.env；不要覆盖默认开发 .env。可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 分别生成密钥。
DATABASE_URL="postgresql://aishop:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/ai_shop?schema=public"
DB_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
REDIS_URL="redis://redis:6379/0"
APP_ENV="production"
NEXTAUTH_URL="https://shop.example.com"
NEXT_PUBLIC_SITE_URL="https://shop.example.com"
NEXT_PUBLIC_SITE_NAME="AI Shop"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_AUTH_SECRET"
ENCRYPTION_KEY="REPLACE_WITH_RANDOM_ENCRYPTION_SECRET"
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"
# 仅首次初始化需要，12-72 位；已有管理员不会被重置。
ADMIN_PASSWORD=""
# 仅当反向代理覆盖 X-Real-IP 且应用端口未公开时设置 true。
TRUST_PROXY="false"
MAX_PENDING_ORDERS="3"
MAX_PENDING_QUANTITY="100"
AUTH_TRUST_HOST="true"
XUNHU_GATEWAY="https://api.xunhupay.com/payment/do.html"
XUNHU_ALIPAY_APPID=""
XUNHU_ALIPAY_APPSECRET=""
XUNHU_WECHAT_APPID=""
XUNHU_WECHAT_APPSECRET=""
USDT_TRC20_ADDRESS=""
TRONGRID_API_KEY=""
USDT_EXCHANGE_RATE="7.2"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SUPPORT_LLM_PROVIDER="sub2api"
SUPPORT_LLM_BASE_URL="http://host.docker.internal:8080/v1"
SUPPORT_LLM_API_KEY=""
SUPPORT_LLM_MODEL="gpt-6-luna"
SUPPORT_LLM_WIRE_API="responses"
