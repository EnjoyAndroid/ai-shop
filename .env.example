# 本地开发/人工验收共用模板；建议直接 npm run env:init 自动生成，无需手填数据库密码。
# 线上模型/支付/邮件：编辑 .deploy/production.env，不要填到这个文件。
# 检查配置：npm run env:status；说明：CONFIGURATION.md。
APP_ENV="development"
DEV_DB_PASSWORD="REPLACE_WITH_DEV_DATABASE_PASSWORD"
DATABASE_URL="postgresql://aishop_dev:REPLACE_WITH_DEV_DATABASE_PASSWORD@127.0.0.1:55440/ai_shop_dev"
REDIS_URL="redis://127.0.0.1:16380/0"
NEXTAUTH_URL="http://127.0.0.1:3013"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3013"
NEXT_PUBLIC_SITE_NAME="AI Shop Development"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_DEV_AUTH_SECRET"
ENCRYPTION_KEY="REPLACE_WITH_RANDOM_DEV_ENCRYPTION_SECRET"
CRON_SECRET="REPLACE_WITH_RANDOM_DEV_CRON_SECRET"
ADMIN_PASSWORD="REPLACE_WITH_RANDOM_DEV_ADMIN_PASSWORD"
AUTH_TRUST_HOST="true"
TRUST_PROXY="false"

# 3013 人工联调可填写专用模型凭据；自动化测试不使用这些值。
SUPPORT_LLM_PROVIDER="sub2api"
SUPPORT_LLM_BASE_URL=""
SUPPORT_LLM_API_KEY=""
SUPPORT_LLM_MODEL="gpt-6-luna"
SUPPORT_LLM_WIRE_API="responses"
# 留空使用后台每日预算，显式 0 表示零预算。
SUPPORT_DAILY_BUDGET_CNY=""
