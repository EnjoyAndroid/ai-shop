# AI Shop - AI 服务自助充值系统

## 环境变量配置

# 数据库 (PostgreSQL - Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:5432/ai_shop?schema=public"

# Redis (Upstash)
REDIS_URL="redis://default:xxxxx@xxx.upstash.io:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# 卡密加密密钥 (32字节 = 256位)
ENCRYPTION_KEY="your-32-bytes-encryption-key-here"

# 支付宝 (虎皮椒/PayJS)
XUNHU_APPID=""
XUNHU_APPSECRET=""
XUNHU_GATEWAY="https://api.xunhupay.com/payment/do.html"

# 微信支付 (虎皮椒/PayJS)
WECHAT_APPID=""
WECHAT_APPSECRET=""

# USDT 支付配置
USDT_TRC20_ADDRESS=""
USDT_ERC20_ADDRESS=""
TRONGRID_API_KEY=""

# 邮件通知 (可选)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Telegram 通知 (可选)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 站点配置
NEXT_PUBLIC_SITE_NAME="AI Shop"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
