{
  "name": "ai-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/environment.mjs dev",
    "build": "node scripts/environment.mjs build",
    "start": "node scripts/environment.mjs start",
    "lint": "next lint",
    "db:push": "node scripts/environment.mjs push",
    "db:generate": "node scripts/environment.mjs generate",
    "db:seed": "node scripts/environment.mjs seed",
    "db:studio": "node scripts/environment.mjs studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/environment.mjs integration",
    "db:migrate": "node scripts/environment.mjs migrate",
    "db:baseline": "node scripts/environment.mjs baseline",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:history": "node scripts/check-commit-metadata.mjs",
    "postinstall": "node scripts/patch-braces.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs",
    "db:prepare": "node scripts/environment.mjs migrate",
    "test:http": "node scripts/environment.mjs http",
    "mail:check": "node --env-file-if-exists=.env --import tsx scripts/check-mail.ts",
    "community:qr": "node --env-file-if-exists=.env --import tsx scripts/generate-community-qr.ts",
    "env:init": "node scripts/environment.mjs init",
    "dev:up": "node scripts/environment.mjs up",
    "dev:down": "node scripts/environment.mjs down",
    "test:up": "node scripts/environment.mjs test-up",
    "test:down": "node scripts/environment.mjs test-down",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:deploy": "node scripts/release.mjs deploy",
    "release:rollback": "node scripts/release.mjs rollback",
    "env:status": "node scripts/environment.mjs status",
    "preview": "node scripts/local-preview.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.105.0",
    "autoprefixer": "^10.6.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "jose": "^6.2.13",
    "lucide-react": "^0.563.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
