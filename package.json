{
  "name": "ai-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/run-test-database.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "node scripts/prepare-database.mjs --baseline-only",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:prepare": "node scripts/prepare-database.mjs",
    "test:http": "node scripts/smoke-security.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.0",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.13",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
